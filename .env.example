##############################
# Petal config
##############################

# Timescale connection
TIMESCALE="postgres://petal@timescale:5432/petal"

# The location of your pcaps as seen by the host
TRAFFIC_DIR_HOST="./services/test_pcap"

# The location of your pcaps (and eve.json), as seen by the container
TRAFFIC_DIR_DOCKER="/traffic"

# Set BPF filter expression (see https://www.tcpdump.org/manpages/pcap-filter.7.html)
#BPF="port 8080"

# Visualizer
#VISUALIZER_URL="http://scraper.example.com"

##############################
# Game config
##############################

# Start time of the CTF (or network open if you prefer)
TICK_START="2024-11-30T13:00:00Z"

# Tick length in ms
TICK_LENGTH=180000

# The flag format in regex
FLAG_REGEX="[A-Z0-9]{31}="

# VM IP (inside gamenet)
# Currently ignored unless FLAGID_SCRAPE is set
VM_IP="10.10.3.1"
TEAM_ID="3"

# Game services shown as tabs in the UI: name:port (ip = VM_IP) or name:ip:port, comma separated
SERVICES=""
#SERVICES="welcome:7001,cybercorp:7002,recipe:7007"
# Written by setup.sh: SERVICES with Docker-published ports resolved to container ip:port
# (the UI matches flows on the ip:port actually seen in the capture). Falls back to SERVICES.
SERVICES_UI=""
# Written by setup.sh: IPs of the containers on the services' Docker networks (nginx, tunnels...).
# HTTP flows that came through one of them get a tag src:<real client ip>, read from
# X-Forwarded-For / X-Real-IP / CF-Connecting-IP (forged entries from clients are skipped).
TRUSTED_PROXIES=""
# Competition VPN range(s), CIDR comma separated (e.g. 10.60.0.0/16). When set, src:<ip> tags are only
# added for attackers inside them (no tags for Docker gateways or LAN PCs). Empty = tag every client.
VPN_RANGES=""

# Host port of the web UI (setup.sh offers the next free port when 3000 is taken)
UI_PORT=3000
# IP the web UI listens on (e.g. your competition network IP); 0.0.0.0 = all addresses of this box
UI_BIND=0.0.0.0

##############################
# CAPTURE CONFIGS (petal-capture container, tcpdump on the host network)
##############################

# Interface(s) to sniff, comma separated (one tcpdump each; setup.sh lists every Docker bridge the
# selected services are attached to). Empty value = capture disabled (e.g. when using PCAP_OVER_IP)
CAPTURE_IFACE=
#CAPTURE_IFACE="eth0"

# BPF filter for what to record
CAPTURE_FILTER="tcp and not port 22 and not port 3000"
#CAPTURE_FILTER="tcp portrange 7000-7007"

# Seconds per pcap file (lower = flows show up faster in Petal)
CAPTURE_ROTATE=60

##############################
# PCAP_OVER_IP CONFIGS
##############################

# Enable pcap-over-ip and choose server endpoint
# Empty value = disabled
PCAP_OVER_IP=
#PCAP_OVER_IP="host.docker.internal:1337"
# For multiple PCAP_OVER_IP you can comma separate
#PCAP_OVER_IP="host.docker.internal:1337,otherhost.com:5050"

##############################
# DUMP_PCAPS CONFIGS
##############################

# Enable pcap dumping and select target location
# Empty value = disabled
DUMP_PCAPS=
#DUMP_PCAPS="/traffic"

# Dumping options
# Ignored unless DUMP_PCAPS is set
DUMP_PCAPS_INTERVAL="1m"
DUMP_PCAPS_FILENAME="2006-01-02_15-04-05.pcap"

##############################
# FLAGID CONFIGS
##############################

# Enable flagid scrapping
# Empty value = disabled
FLAGID_SCRAPE=
#FLAGID_SCRAPE=1

# Enable flagid scanning - Tags flag ids in traffic
# Empty value = disabled
# Does nothing unless FLAGID_SCRAPE is set
FLAGID_SCAN=
#FLAGID_SCAN=1

# Flag lifetime in ticks
# Empty value = Fallback to TICK_LENGTH
# -1 = No check, pls don't use outside testing
FLAG_LIFETIME=
#FLAG_LIFETIME=-1
#FLAG_LIFETIME=5

# Flagid endpoint
# Default value is a test container in docker-compose-test.yml, change this for production
# Ignored unless FLAGID_SCRAPE is set
FLAGID_ENDPOINT="http://flagidendpoint:8000/flagids.json"

##############################
# FLAG_VALIDATOR CONFIGS
##############################

# Enables flag validation / fake flag feature. Must be one of: faust, enowars, eno, itad
# Empty value = disabled
FLAG_VALIDATOR_TYPE=

# Some flag validators can make use of (our) team number/ID
# Ignored unless FLAG_VALIDATOR_TYPE is set
FLAG_VALIDATOR_TEAM=42

##############################
# SURICATA CONFIGS
##############################

# Directory for Suricata files (see suricata/etc, suricata/lib/rules, suricata/logs)
# (they should be generated on first run)
#SURICATA_DIR_HOST="./suricata"
